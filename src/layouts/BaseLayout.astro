---
import "../styles/globals.css";

interface Props {
  title: string;
  description?: string;
  /** Ruta de la imagen de compartir, relativa al dominio. */
  image?: string;
  /** Paginas que no deben indexarse, como el 404. */
  noindex?: boolean;
}

const { title, description, image = "/og.jpg", noindex = false } = Astro.props;

const resumen =
  description ??
  "Desarrollamos webs, apps moviles y sistemas internos a medida. De la primera reunion al lanzamiento en 2 a 3 semanas, con alcance y precio por escrito.";

// Astro.site viene de astro.config.mjs; sin el, WhatsApp y LinkedIn no
// resuelven la imagen porque Open Graph exige URL absolutas.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={resumen} />
    <meta name="theme-color" content="#0A0A0B" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AdaptaWeb" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resumen} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="420" />
    <meta property="og:image:alt" content="AdaptaWeb — webs, apps y sistemas a medida" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resumen} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <link rel="icon" href="/fav.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:wght@400;700&display=swap"
    />

    <!-- Barrido entre páginas. Va aquí, en línea y en la cabecera, porque el
         recorte inicial tiene que existir antes del primer pintado: si llegara
         con el resto de los scripts se vería la página entera un instante y
         después el círculo. Es el mismo gesto que usan las demos del
         portafolio para pasar de claro a oscuro. -->
    <script is:inline>
      (function () {
        var CLAVE = "aw:barrido";
        var DURACION = 620;
        var CURVA = "cubic-bezier(.65, 0, .35, 1)";
        var quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Al salir: de dónde se pulsó y de qué color era el fondo que se deja.
        document.addEventListener(
          "click",
          function (ev) {
            if (quieto || ev.defaultPrevented || ev.button !== 0) return;
            if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
            var a = ev.target.closest && ev.target.closest("a[href]");
            if (!a || a.target === "_blank" || a.hasAttribute("download")) return;

            var destino;
            try {
              destino = new URL(a.href, location.href);
            } catch (e) {
              return;
            }
            // Otro dominio, un ancla de esta misma página o un mailto: no hay salto.
            if (destino.origin !== location.origin) return;
            if (destino.pathname === location.pathname) return;

            // Con teclado no hay coordenadas: sale del centro del enlace.
            var caja = a.getBoundingClientRect();
            var x = ev.clientX || Math.round(caja.left + caja.width / 2);
            var y = ev.clientY || Math.round(caja.top + caja.height / 2);
            // Un punto fuera de la pantalla daría un círculo que nace donde no
            // se ve; en ese caso vale más que salga del centro.
            if (x < 0 || y < 0 || x > innerWidth || y > innerHeight) {
              x = Math.round(innerWidth / 2);
              y = Math.round(innerHeight / 2);
            }

            try {
              sessionStorage.setItem(
                CLAVE,
                JSON.stringify({
                  x: x,
                  y: y,
                  fondo: getComputedStyle(document.body).backgroundColor,
                  t: Date.now(),
                }),
              );
            } catch (e) {}
          },
          true,
        );

        // Al entrar: la página se revela en un círculo que crece desde ese punto.
        var crudo = null;
        try {
          crudo = sessionStorage.getItem(CLAVE);
          sessionStorage.removeItem(CLAVE);
        } catch (e) {}
        if (!crudo || quieto) return;

        var d;
        try {
          d = JSON.parse(crudo);
        } catch (e) {
          return;
        }
        // Un clic viejo es de otra navegación: con el botón atrás no se repite.
        if (!d || Date.now() - d.t > 4000) return;

        // En una pestaña que no se está pintando el reloj de la animación no
        // avanza: el recorte se quedaría en circle(0%) y la página invisible.
        // Así que ni se arma.
        if (document.visibilityState !== "visible") return;

        var punto = d.x + "px " + d.y + "px";
        var hoja = document.createElement("style");
        hoja.textContent =
          "html{background:" + d.fondo + "}" +
          ".aw-barrido{clip-path:circle(0% at " + punto + ")}";
        document.head.appendChild(hoja);

        document.addEventListener("DOMContentLoaded", function () {
          var pagina = document.querySelector(".aw-landing");
          if (!pagina) {
            hoja.remove();
            return;
          }
          pagina.classList.add("aw-barrido");

          var limpio = false;
          var anim = null;
          var limpiar = function () {
            if (limpio) return;
            limpio = true;
            // cancel() hace falta además de quitar la clase: con fill "both" la
            // animación sigue imponiendo su valor aunque la regla ya no esté, y
            // la página se quedaría recortada al 0%, o sea invisible.
            if (anim) anim.cancel();
            // Fuera el recorte: mientras está puesto, la barra fija se recorta con él.
            pagina.classList.remove("aw-barrido");
            hoja.remove();
          };

          anim = pagina.animate(
            [
              { clipPath: "circle(0% at " + punto + ")" },
              { clipPath: "circle(150% at " + punto + ")" },
            ],
            { duration: DURACION, easing: CURVA, fill: "both" },
          );
          anim.onfinish = limpiar;

          // requestAnimationFrame solo llega si la página pinta de verdad. Si
          // no llega, la animación nunca va a correr: se descubre la página.
          var pintando = false;
          requestAnimationFrame(function () {
            pintando = true;
          });
          setTimeout(function () {
            if (!pintando) limpiar();
          }, 250);

          // Si la pestaña se esconde a mitad, se queda congelada: mejor cortar.
          document.addEventListener("visibilitychange", function () {
            if (document.visibilityState !== "visible") limpiar();
          });

          setTimeout(limpiar, DURACION + 250);
        });
      })();
    </script>
  </head>
  <body class="text-text-primary antialiased">
    <slot />
  </body>
</html>
