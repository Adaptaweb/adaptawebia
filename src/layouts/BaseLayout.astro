---
import "../styles/globals.css";

interface Props {
  title: string;
  description?: string;
  /** Ruta de la imagen de compartir, relativa al dominio. */
  image?: string;
  /** Paginas que no deben indexarse, como el 404. */
  noindex?: boolean;
}

const { title, description, image = "/og.jpg", noindex = false } = Astro.props;

const resumen =
  description ??
  "Desarrollamos webs, apps moviles y sistemas internos a medida. De la primera reunion al lanzamiento en 2 a 3 semanas, con alcance y precio por escrito.";

// Astro.site viene de astro.config.mjs; sin el, WhatsApp y LinkedIn no
// resuelven la imagen porque Open Graph exige URL absolutas.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={resumen} />
    <meta name="theme-color" content="#0A0A0B" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AdaptaWeb" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resumen} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="420" />
    <meta property="og:image:alt" content="AdaptaWeb — webs, apps y sistemas a medida" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resumen} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <link rel="icon" href="/fav.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:wght@400;700&display=swap"
    />

    <!-- Barrido entre páginas. Un disco del color de la página anterior tapa
         la nueva y se encoge hacia el punto donde se hizo clic, así que la
         página parece salir de ahí. Es el mismo gesto que usan las demos del
         portafolio para pasar de claro a oscuro.

         Va en línea y en la cabecera por dos razones: el disco tiene que estar
         puesto antes del primer pintado, y se anima solo `transform`, que el
         navegador compone aparte. Recortar la página con clip-path se probó
         primero y no sirve: esa animación corre en el hilo principal, que al
         cargar una página está ocupado, y su reloj avanzaba 11 ms en 870. -->
    <script is:inline>
      (function () {
        var CLAVE = "aw:barrido";
        var DURACION = 620;
        var CURVA = "cubic-bezier(.65, 0, .35, 1)";
        var quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Al salir: de dónde se pulsó y de qué color era el fondo que se deja.
        document.addEventListener(
          "click",
          function (ev) {
            if (quieto || ev.defaultPrevented || ev.button !== 0) return;
            if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
            var a = ev.target.closest && ev.target.closest("a[href]");
            if (!a || a.target === "_blank" || a.hasAttribute("download")) return;

            var destino;
            try {
              destino = new URL(a.href, location.href);
            } catch (e) {
              return;
            }
            // Otro dominio, un ancla de esta misma página o un mailto: no hay salto.
            if (destino.origin !== location.origin) return;
            if (destino.pathname === location.pathname) return;

            // Con teclado no hay coordenadas: sale del centro del enlace.
            var caja = a.getBoundingClientRect();
            var x = ev.clientX || Math.round(caja.left + caja.width / 2);
            var y = ev.clientY || Math.round(caja.top + caja.height / 2);
            // Un punto fuera de la pantalla daría un círculo que nace donde no
            // se ve; en ese caso vale más que salga del centro.
            if (x < 0 || y < 0 || x > innerWidth || y > innerHeight) {
              x = Math.round(innerWidth / 2);
              y = Math.round(innerHeight / 2);
            }

            try {
              sessionStorage.setItem(
                CLAVE,
                JSON.stringify({
                  x: x,
                  y: y,
                  fondo: getComputedStyle(document.body).backgroundColor,
                  t: Date.now(),
                }),
              );
            } catch (e) {}
          },
          true,
        );

        // Al entrar: el disco se encoge y deja ver la página.
        var crudo = null;
        try {
          crudo = sessionStorage.getItem(CLAVE);
          sessionStorage.removeItem(CLAVE);
        } catch (e) {}
        if (!crudo || quieto) return;

        var d;
        try {
          d = JSON.parse(crudo);
        } catch (e) {
          return;
        }
        // Un clic viejo es de otra navegación: con el botón atrás no se repite.
        if (!d || Date.now() - d.t > 4000) return;
        // En una pestaña que no se pinta nada se anima: mejor no tapar nada.
        if (document.visibilityState !== "visible") return;

        // El disco tiene que cubrir la ventana entera desde ese punto.
        var lado = Math.ceil(2 * Math.hypot(innerWidth, innerHeight)) + 2;
        var ancla =
          "translate(" + (d.x - lado / 2) + "px, " + (d.y - lado / 2) + "px)";

        var disco = document.createElement("div");
        disco.setAttribute("aria-hidden", "true");
        disco.style.cssText =
          "position:fixed;left:0;top:0;z-index:2147483646;pointer-events:none;" +
          "border-radius:50%;background:" + d.fondo + ";" +
          "width:" + lado + "px;height:" + lado + "px;" +
          "transform:" + ancla + " scale(1);will-change:transform";
        // Antes de que exista <body>: en la cabecera solo está <html>.
        document.documentElement.appendChild(disco);

        var fuera = false;
        var quitar = function () {
          if (fuera) return;
          fuera = true;
          if (disco.parentNode) disco.parentNode.removeChild(disco);
        };

        // requestAnimationFrame solo llega si la página pinta de verdad. Si no
        // llega, la animación nunca correría y el disco taparía la página.
        var pintando = false;
        requestAnimationFrame(function () {
          pintando = true;
          var anim = disco.animate(
            [{ transform: ancla + " scale(1)" }, { transform: ancla + " scale(0)" }],
            { duration: DURACION, easing: CURVA, fill: "forwards" },
          );
          anim.onfinish = quitar;
        });
        setTimeout(function () {
          if (!pintando) quitar();
        }, 250);

        // Si la pestaña se esconde a mitad, la animación se congela: cortar.
        document.addEventListener("visibilitychange", function () {
          if (document.visibilityState !== "visible") quitar();
        });

        setTimeout(quitar, DURACION + 400);
      })();
    </script>
  </head>
  <body class="text-text-primary antialiased">
    <slot />
  </body>
</html>
