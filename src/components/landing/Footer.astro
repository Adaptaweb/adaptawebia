---
import Logo from "../Logo.astro";
---

<!-- ============ FOOTER ============ -->
<footer style="position: relative; background: #060708; padding: 56px 24px 0; overflow: hidden">
  <div style="margin: 0 auto; max-width: 1400px">

    <div aria-hidden="true" style="margin-bottom: 48px">
      <p style="margin: 0 0 16px; text-align: center; font-family: 'Space Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: #4A4A4F">48 piezas en proyectos reales</p>
      <div class="mq-wrap" style="overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent)">
        <div class="mq" style="gap: 34px; font-family: 'Space Mono', monospace; font-size: 14px; color: #45FF8C; opacity: .45">
          <div style="display: flex; gap: 34px; padding-right: 34px; white-space: nowrap">
            <span>Astro</span><span>React</span><span>TypeScript</span><span>Tailwind CSS v4</span><span>Vite</span><span>shadcn/ui</span><span>Base UI</span><span>Framer Motion</span><span>Three.js</span><span>React Three Fiber</span><span>Konva</span><span>Recharts</span><span>TanStack Table</span><span>React Hook Form + Zod</span><span>PWA</span><span>Flutter</span><span>Riverpod</span><span>Drift</span><span>sqflite</span><span>go_router</span><span>mobile_scanner</span><span>ML Kit OCR</span><span>local_auth</span><span>Firebase Messaging</span>
          </div>
          <div style="display: flex; gap: 34px; padding-right: 34px; white-space: nowrap">
            <span>Astro</span><span>React</span><span>TypeScript</span><span>Tailwind CSS v4</span><span>Vite</span><span>shadcn/ui</span><span>Base UI</span><span>Framer Motion</span><span>Three.js</span><span>React Three Fiber</span><span>Konva</span><span>Recharts</span><span>TanStack Table</span><span>React Hook Form + Zod</span><span>PWA</span><span>Flutter</span><span>Riverpod</span><span>Drift</span><span>sqflite</span><span>go_router</span><span>mobile_scanner</span><span>ML Kit OCR</span><span>local_auth</span><span>Firebase Messaging</span>
          </div>
        </div>
      </div>
      <div class="mq-wrap" style="overflow: hidden; margin-top: 12px; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent)">
        <div class="mq mq-back" style="gap: 34px; font-family: 'Space Mono', monospace; font-size: 14px; color: #8E8E93; opacity: .5">
          <div style="display: flex; gap: 34px; padding-right: 34px; white-space: nowrap">
            <span>speech_to_text</span><span>share_plus</span><span>FastAPI</span><span>Uvicorn</span><span>SQLAlchemy</span><span>Alembic</span><span>Node.js</span><span>Express</span><span>Astro SSR</span><span>Medusa</span><span>PostgreSQL</span><span>Supabase</span><span>MongoDB</span><span>Redis</span><span>SQLite</span><span>Google Gemini</span><span>Vosk</span><span>Docker Compose</span><span>Cloudflare Workers</span><span>Wrangler</span><span>Vercel</span><span>Turnstile</span><span>Resend</span><span>Playwright</span>
          </div>
          <div style="display: flex; gap: 34px; padding-right: 34px; white-space: nowrap">
            <span>speech_to_text</span><span>share_plus</span><span>FastAPI</span><span>Uvicorn</span><span>SQLAlchemy</span><span>Alembic</span><span>Node.js</span><span>Express</span><span>Astro SSR</span><span>Medusa</span><span>PostgreSQL</span><span>Supabase</span><span>MongoDB</span><span>Redis</span><span>SQLite</span><span>Google Gemini</span><span>Vosk</span><span>Docker Compose</span><span>Cloudflare Workers</span><span>Wrangler</span><span>Vercel</span><span>Turnstile</span><span>Resend</span><span>Playwright</span>
          </div>
        </div>
      </div>
    </div>

    <div style="display: flex; justify-content: center">
      <a class="foot-logo" href="#hero" style="color: #F5F5F7; text-decoration: none">
        <Logo variant="stacked" size={72} />
      </a>
    </div>

    <div aria-hidden="true" style="margin-top: 30px; border-top: 1px solid rgba(255,255,255,.1)"></div>

    <div style="margin-top: 32px; padding-bottom: 32px; display: flex; flex-wrap: wrap; gap: 44px; justify-content: space-between">
      <div style="flex: 0 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
        <p style="margin: 0; font-size: 14px; font-weight: 650; color: #FFFFFF">Newsletter</p>
        <form class="nl" onsubmit="return false">
          <label class="sr" for="nl-email">Tu correo</label>
          <input id="nl-email" name="email" type="email" autocomplete="email" placeholder="tu@email.com" required>
          <button type="submit" aria-label="Suscribirme">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </button>
        </form>
        <p style="margin: 0; font-size: 12px; color: #6B6B70">Sin spam. Solo novedades y lanzamientos.</p>
      </div>

      <nav class="fnav" aria-label="Pie de página" style="display: grid; grid-template-columns: repeat(2, auto); gap: 10px 64px; align-content: start">
        <a href="#hero">Inicio</a>
        <a href="#proceso">Así trabajamos</a>
        <a href="#servicios">Servicios</a>
        <a href="#stack">Comparativa</a>
        <a href="#trabajo">Trabajo real</a>
        <a href="#faq">Preguntas</a>
        <a href="#cotizar">Cotizar</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </div>

    <div aria-hidden="true" style="border-top: 1px solid rgba(255,255,255,.1)"></div>

    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0 26px">
      <p style="margin: 0; font-size: 12px; color: #6B6B70">© 2026 AdaptaWeb</p>

      <div style="display: flex; align-items: center; justify-content: center; gap: 10px">
        <a class="soc" href="https://github.com/Adaptaweb" target="_blank" rel="noopener noreferrer" aria-label="GitHub" style="--brand: #FFFFFF">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
          <span class="lbl">/adaptaweb</span>
        </a>
        <a class="soc" href="https://www.linkedin.com/in/alejandro-tamayo-e/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" style="--brand: #0A66C2">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0A66C2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          <span class="lbl">/Alejandro</span>
        </a>
        <a class="soc" href="https://adaptaweb.cl" target="_blank" rel="noopener noreferrer" aria-label="AdaptaWeb" style="--brand: #45FF8C">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#45FF8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20M12 2a15.3 15.3 0 0 0 0 20"></path></svg>
          <span class="lbl">/adaptaweb.cl</span>
        </a>
      </div>

      <p style="margin: 0; font-size: 12px; color: #6B6B70">adaptaweb.cl</p>
    </div>
  </div>
</footer>
