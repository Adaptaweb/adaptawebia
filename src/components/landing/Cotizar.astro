<!-- ============ COTIZAR (banda verde) ============ -->
<section id="cotizar" style="position: relative; background: #45FF8C; color: #04150B; padding: 44px 24px 92px; overflow: hidden">
  <div style="margin: 0 auto; max-width: 1040px; display: flex; flex-wrap: wrap; align-items: center; gap: 40px">
    <div style="flex: 1 1 520px; min-width: 0">
      <p class="rv" style="margin: 0 0 16px; font-family: 'Geist Mono', monospace; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: #0A3D1E">Propuesta cerrada</p>
      <h2 class="rb d1" style="margin: 0 0 16px; font-size: 62px; line-height: 1.02; letter-spacing: -.05em; font-weight: 800; color: #04150B">Tu web a medida, cotizada para tu negocio.</h2>
      <p class="rv d2" style="margin: 0; font-size: 20px; line-height: 1.6; color: #0C2E18">Te enviamos una propuesta cerrada después de entender tu proyecto. Sin cobros sorpresa a mitad de camino.</p>
    </div>
    <div class="rv d3" style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
      <a class="btn" href="#contacto" style="background: #04150B; color: #45FF8C; text-decoration: none; font-weight: 700; font-size: 17px; border-radius: 999px; padding: 0 32px; min-height: 60px; display: inline-flex; align-items: center; justify-content: center; gap: 10px">
        Cotizar proyecto
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
      </a>
      <p style="margin: 0; text-align: center; font-size: 14px; color: #0C2E18">Respondemos con alcance, plazo y precio. Sin compromiso.</p>
    </div>
  </div>
</section>

