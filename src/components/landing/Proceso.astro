  <svg class="wave w-front" viewBox="0 0 1440 150" preserveAspectRatio="none" style="top: 0"><path d="M0,70 C240,130 480,10 720,70 C960,130 1200,10 1440,70 L1440,0 L0,0 Z" fill="#131716"></path></svg>
