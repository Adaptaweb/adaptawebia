<!-- ============ SERVICIOS ============ -->
<section id="servicios" style="position: relative; background: #F3F5F4; color: #0B0E0F; padding: 10px 24px 96px; overflow: hidden">
  <div aria-hidden="true" class="drift" style="position: absolute; top: -8%; right: -12%; width: 780px; height: 780px; border-radius: 50%; background: radial-gradient(closest-side, rgba(15,154,71,.12), transparent 70%)"></div>
  <div aria-hidden="true" class="drift" style="position: absolute; bottom: -16%; left: -10%; width: 700px; height: 700px; border-radius: 50%; background: radial-gradient(closest-side, rgba(15,154,71,.08), transparent 70%); animation-delay: -9s"></div>
  <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(rgba(11,14,15,.09) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(100% 70% at 50% 36%, #000 10%, transparent 78%); -webkit-mask-image: radial-gradient(100% 70% at 50% 36%, #000 10%, transparent 78%)"></div>

  <div style="position: relative; margin: 0 auto; max-width: 1240px">
    <div style="display: flex; align-items: flex-end; gap: 32px; margin-bottom: 36px">
      <div style="max-width: 680px">
        <p class="rv" style="margin: 0 0 14px; font-family: 'Space Mono', monospace; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: #0B7A38">Lo que incluye tu proyecto</p>
        <h2 class="rb d1" style="margin: 0; font-size: 58px; line-height: 1.04; letter-spacing: -.05em; font-weight: 800; color: #0B0E0F">Servicio completo, <span style="color: #0F9A47">de la estrategia al lanzamiento</span>.</h2>
      </div>
    </div>

    <div class="exp rv d2" id="aw-exp">
      <input type="radio" name="svc" id="x1" checked>
      <input type="radio" name="svc" id="x2">
