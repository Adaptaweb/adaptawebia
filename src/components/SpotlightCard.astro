---
interface Props {
  class?: string;
  colSpan?: "1" | "2";
  rowSpan?: "1" | "2";
}

const { class: className, colSpan = "1", rowSpan = "1" } = Astro.props;
const spanVars = `--col-span: ${colSpan}; --row-span: ${rowSpan}`;
---

<div
  class={className + " group relative overflow-hidden rounded-2xl border border-white/5 bg-secondary/10 backdrop-blur-xl shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] p-8 transition-all duration-500"}
  style={spanVars}
  data-spotlight
>
  <div class="spotlight-glow pointer-events-none absolute -inset-px rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" data-spotlight-glow />
  <div class="relative z-10">
    <slot />
  </div>
</div>

<style>
  .spotlight-glow {
    background: radial-gradient(600px circle at var(--spotlight-x, 50%) var(--spotlight-y, 50%), rgba(69,255,140,0.08), transparent 40%);
  }
  [data-spotlight] {
    grid-column: span var(--col-span, 1);
    grid-row: span var(--row-span, 1);
  }
</style>
