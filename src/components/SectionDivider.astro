---
/**
 * Separador entre secciones: dos líneas que se dibujan desde el centro al aparecer
 * y un orbe que late. El título de la sección va justo debajo.
 */
---

<div class="mx-auto flex w-full max-w-[1100px] items-center px-6 pt-10" aria-hidden="true">
  <span data-reveal="draw-left" class="h-px flex-1 bg-gradient-to-r from-primary/0 to-primary/55"></span>
  <span class="flex px-5">
    <span class="aw-orb h-2.5 w-2.5 rounded-full bg-primary"></span>
  </span>
  <span data-reveal="draw-right" class="h-px flex-1 bg-gradient-to-r from-primary/55 to-primary/0"></span>
</div>
