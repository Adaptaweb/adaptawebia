---
/**
 * Separador entre secciones: dos líneas que se dibujan desde el centro al aparecer,
 * un orbe que late y la etiqueta del capítulo que empieza.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="relative mx-auto flex w-full max-w-[1100px] items-center px-6 pt-10" aria-hidden="true">
  <span data-reveal="draw-left" class="h-px flex-1 bg-gradient-to-r from-primary/0 to-primary/55"></span>
  <span class="relative flex px-5">
    <span class="aw-orb h-2.5 w-2.5 rounded-full bg-primary"></span>
  </span>
  <span data-reveal="draw-right" class="h-px flex-1 bg-gradient-to-r from-primary/55 to-primary/0"></span>
  <span
    data-reveal
    class="absolute left-1/2 top-0 -translate-x-1/2 whitespace-nowrap rounded-full border border-primary/25 bg-primary/10 px-3 py-1 font-mono text-xs text-primary"
  >
    {label}
  </span>
</div>
