---
import SpotlightCard from "./SpotlightCard.astro";
---

<section id="servicios" class="relative py-24 md:py-32 overflow-hidden">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mb-16" data-reveal>
      <p class="font-mono text-xs tracking-[0.25em] text-primary mb-4 uppercase">Servicios</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tighter text-white">
        Construimos el futuro digital
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5 auto-rows-[240px] md:auto-rows-[260px]">
      <SpotlightCard colSpan="2" rowSpan="1" class="flex flex-col justify-between">
        <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path d="M12 2a10 10 0 0 1 10 10c0 5-4 8-10 8s-10-3-10-8 4-10 10-10z"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="text-lg md:text-xl font-semibold text-white mb-2">Despliegues con IA y Modelos LLM</h3>
        <p class="text-sm text-text-muted leading-relaxed">Integración de agentes autónomos, embeddings y lógica inteligente en el core de tu negocio.</p>
      </SpotlightCard>
      <SpotlightCard colSpan="1" rowSpan="1" class="flex flex-col justify-between">
        <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg>
        </div>
        <h3 class="text-lg md:text-xl font-semibold text-white mb-2">CI/CD Eficiente</h3>
        <p class="text-sm text-text-muted leading-relaxed">Flujos automatizados que llevan ideas a producción en tiempo récord.</p>
      </SpotlightCard>
      <SpotlightCard colSpan="1" rowSpan="2" class="flex flex-col justify-between">
        <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        </div>
        <h3 class="text-lg md:text-xl font-semibold text-white mb-2">Web &amp; Mobile Premium</h3>
        <p class="text-sm text-text-muted leading-relaxed">Apps iOS/Android y plataformas reactivas bajo arquitecturas limpias y escalables.</p>
      </SpotlightCard>
      <SpotlightCard colSpan="2" rowSpan="1" class="flex flex-col justify-between">
        <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h3 class="text-lg md:text-xl font-semibold text-white mb-2">Diseño Web Adaptativo de Vanguardia</h3>
        <p class="text-sm text-text-muted leading-relaxed">Interfaces líquidas basadas en comportamientos de datos reales para experiencias únicas.</p>
      </SpotlightCard>
    </div>
  </div>
</section>

<script>
const cards = document.querySelectorAll("[data-spotlight]");
cards.forEach((card) => {
  const glow = card.querySelector("[data-spotlight-glow]");
  if (!glow) return;
  card.addEventListener("pointermove", (e) => {
    const rect = card.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;
    glow.style.setProperty("--spotlight-x", x + "%");
    glow.style.setProperty("--spotlight-y", y + "%");
  });
});
</script>
