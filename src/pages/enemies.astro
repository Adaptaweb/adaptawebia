---
// Hidden landing page — not linked from anywhere in the site navigation.
// Single purpose: download the Enemies: Protocolo Cero launcher.
const DOWNLOAD_URL = "https://adaptaweb.cl/enemiesland_launcher.exe";

// Keep the page out of search engines.
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enemies: Protocolo Cero — Launcher</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#0B0F0A" />
    <link rel="icon" href="/enemies/icon.png" />
    <link rel="preload" as="image" href="/enemies/logo.jpeg" />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        background-color: #0b0f0a;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
        color: #e8f3e2;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      ::selection {
        background-color: #7ac943;
        color: #0b0f0a;
      }

      /* ---------- fixed background ---------- */

      .bg-video {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        filter: saturate(1.05) contrast(1.05) brightness(0.5);
      }

      .bg-overlay {
        position: fixed;
        inset: 0;
        z-index: 1;
        background:
          radial-gradient(
            circle at 50% 30%,
            rgba(122, 201, 67, 0.14),
            transparent 55%
          ),
          linear-gradient(
            to bottom,
            rgba(11, 15, 10, 0.84) 0%,
            rgba(11, 15, 10, 0.66) 35%,
            rgba(11, 15, 10, 0.94) 100%
          );
      }

      /* Subtle scanline texture for the post-apocalyptic feel. */
      .bg-scanlines {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        opacity: 0.25;
        background-image: repeating-linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.35) 0px,
          rgba(0, 0, 0, 0.35) 1px,
          transparent 1px,
          transparent 3px
        );
      }

      .page {
        position: relative;
        z-index: 3;
      }

      /* ---------- hero ---------- */

      .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 3.5rem 1.25rem 5.5rem;
        text-align: center;
      }

      .logo {
        width: min(680px, 92vw);
        height: auto;
        display: block;
        border-radius: 14px;
        border: 1px solid rgba(122, 201, 67, 0.28);
        box-shadow:
          0 0 0 1px rgba(0, 0, 0, 0.6),
          0 24px 70px rgba(0, 0, 0, 0.75),
          0 0 90px rgba(122, 201, 67, 0.12);
        animation: fade-up 0.9s ease-out both;
      }

      .tagline {
        margin: 0;
        max-width: 46ch;
        font-size: clamp(0.95rem, 2.4vw, 1.15rem);
        line-height: 1.6;
        color: #b6c9ad;
        animation: fade-up 0.9s ease-out 0.12s both;
      }

      .download {
        --glow: rgba(122, 201, 67, 0.45);
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        padding: 1.15rem 2.6rem;
        border: 2px solid #7ac943;
        border-radius: 10px;
        background: linear-gradient(180deg, #7ac943 0%, #4e8f28 100%);
        color: #08120a;
        font-size: clamp(1.05rem, 2.6vw, 1.3rem);
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        overflow: hidden;
        box-shadow:
          0 0 26px var(--glow),
          0 10px 30px rgba(0, 0, 0, 0.55),
          inset 0 1px 0 rgba(255, 255, 255, 0.35);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          filter 0.18s ease;
        animation:
          fade-up 0.9s ease-out 0.24s both,
          pulse-glow 3s ease-in-out 1.2s infinite;
      }

      /* Light sweep across the button. */
      .download::after {
        content: "";
        position: absolute;
        top: 0;
        left: -60%;
        width: 45%;
        height: 100%;
        background: linear-gradient(
          100deg,
          transparent,
          rgba(255, 255, 255, 0.55),
          transparent
        );
        transform: skewX(-20deg);
        animation: sweep 4.5s ease-in-out 1.8s infinite;
        pointer-events: none;
      }

      .download:hover,
      .download:focus-visible {
        transform: translateY(-3px);
        filter: brightness(1.08);
        box-shadow:
          0 0 44px var(--glow),
          0 16px 40px rgba(0, 0, 0, 0.6),
          inset 0 1px 0 rgba(255, 255, 255, 0.45);
      }

      .download:focus-visible {
        outline: 3px solid #e8f3e2;
        outline-offset: 4px;
      }

      .download:active {
        transform: translateY(0);
      }

      .download svg {
        flex: none;
        animation: bob 2.4s ease-in-out infinite;
      }

      .meta {
        margin: 0;
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #7f9276;
        animation: fade-up 0.9s ease-out 0.36s both;
      }

      .scroll-hint {
        position: absolute;
        bottom: 1.75rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        color: #6d8064;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        text-decoration: none;
        animation: fade-up 0.9s ease-out 0.6s both;
      }

      .scroll-hint:hover {
        color: #9dbb8e;
      }

      .scroll-hint svg {
        animation: bob 1.8s ease-in-out infinite;
      }

      /* ---------- screenshot section ---------- */

      .showcase {
        padding: 1rem 1.25rem 6rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        text-align: center;
      }

      .showcase .eyebrow {
        margin: 0;
        font-size: 0.72rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #7ac943;
      }

      .showcase h2 {
        margin: 0;
        font-size: clamp(1.5rem, 4.5vw, 2.25rem);
        font-weight: 800;
        letter-spacing: 0.02em;
      }

      .showcase p {
        margin: 0;
        max-width: 52ch;
        line-height: 1.6;
        color: #b6c9ad;
      }

      .shot-frame {
        position: relative;
        width: min(1040px, 94vw);
        margin-top: 0.5rem;
        border-radius: 12px;
        padding: 6px;
        background: linear-gradient(
          160deg,
          rgba(122, 201, 67, 0.35),
          rgba(122, 201, 67, 0.05) 45%,
          rgba(255, 69, 0, 0.22)
        );
        box-shadow:
          0 30px 80px rgba(0, 0, 0, 0.7),
          0 0 70px rgba(122, 201, 67, 0.1);
        perspective: 1200px;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        transform-style: preserve-3d;
        will-change: transform;
      }

      .shot-frame img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
      }

      /* Glare that follows the pointer across the screenshot. */
      .shot-glare {
        position: absolute;
        inset: 6px;
        border-radius: 8px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
        background: radial-gradient(
          circle at var(--gx, 50%) var(--gy, 50%),
          rgba(255, 255, 255, 0.16),
          transparent 45%
        );
      }

      .shot-frame:hover .shot-glare {
        opacity: 1;
      }

      .features {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem 0.75rem;
      }

      .features li {
        padding: 0.5rem 1rem;
        border: 1px solid rgba(122, 201, 67, 0.25);
        border-radius: 999px;
        background: rgba(11, 15, 10, 0.55);
        font-size: 0.82rem;
        color: #b6c9ad;
      }

      .closing {
        padding: 0 1.25rem 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-align: center;
      }

      /* ---------- scroll reveal ---------- */

      .reveal {
        opacity: 0;
      }

      .reveal.is-visible {
        animation: reveal-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .reveal.is-visible[data-delay="1"] {
        animation-delay: 0.1s;
      }
      .reveal.is-visible[data-delay="2"] {
        animation-delay: 0.2s;
      }
      .reveal.is-visible[data-delay="3"] {
        animation-delay: 0.3s;
      }

      /* ---------- keyframes ---------- */

      @keyframes fade-up {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes reveal-up {
        from {
          opacity: 0;
          transform: translateY(28px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes pulse-glow {
        0%,
        100% {
          box-shadow:
            0 0 26px var(--glow),
            0 10px 30px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 255, 255, 0.35);
        }
        50% {
          box-shadow:
            0 0 46px var(--glow),
            0 10px 30px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 255, 255, 0.35);
        }
      }

      @keyframes sweep {
        0%,
        55% {
          left: -60%;
        }
        85%,
        100% {
          left: 130%;
        }
      }

      @keyframes bob {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(3px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .logo,
        .tagline,
        .download,
        .download::after,
        .download svg,
        .meta,
        .scroll-hint,
        .scroll-hint svg {
          animation: none;
        }
        .download,
        .shot-frame {
          transition: none;
        }
        .reveal,
        .reveal.is-visible {
          animation: none;
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <video
      class="bg-video"
      src="/enemies/intro.mp4"
      poster="/enemies/logo.jpeg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"></video>
    <div class="bg-overlay" aria-hidden="true"></div>
    <div class="bg-scanlines" aria-hidden="true"></div>

    <div class="page">
      <main class="hero">
        <img
          class="logo"
          src="/enemies/logo.jpeg"
          alt="Enemies: Protocolo Cero"
          width="1406"
          height="768"
          fetchpriority="high"
        />

        <p class="tagline">
          Descarga el launcher oficial e inicia sesión para entrar al servidor.
        </p>

        <a class="download" href={DOWNLOAD_URL} download>
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"
            stroke-linejoin="miter"
            aria-hidden="true"
          >
            <path d="M12 3v12" />
            <path d="M6 11l6 6 6-6" />
            <path d="M4 21h16" />
          </svg>
          Descargar Launcher
        </a>

        <p class="meta">Windows · .exe</p>

        <a class="scroll-hint" href="#launcher">
          Ver el launcher
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6" />
          </svg>
        </a>
      </main>

      <section class="showcase" id="launcher">
        <p class="eyebrow reveal">Así se ve</p>
        <h2 class="reveal" data-delay="1">Un solo botón: JUGAR</h2>
        <p class="reveal" data-delay="2">
          El launcher instala Java, Fabric, los mods del servidor y el tema
          visual. Inicias sesión con tu cuenta de Microsoft y entras directo a
          la partida.
        </p>

        <div class="shot-frame reveal" data-delay="3" id="shot">
          <img
            src="/enemies/launcher.webp"
            alt="Ventana del launcher de EnemiesLand: cuenta de Microsoft conectada, estado de instalación de Java, Fabric, mods y tema visual, y el botón JUGAR"
            width="1620"
            height="993"
            loading="lazy"
            decoding="async"
          />
          <span class="shot-glare" aria-hidden="true"></span>
        </div>

        <ul class="features">
          <li class="reveal">Instala Java automáticamente</li>
          <li class="reveal" data-delay="1">Fabric 26.2</li>
          <li class="reveal" data-delay="2">Mods del servidor</li>
          <li class="reveal" data-delay="3">Login con Microsoft</li>
        </ul>
      </section>

      <section class="closing">
        <a class="download" href={DOWNLOAD_URL} download>
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"
            stroke-linejoin="miter"
            aria-hidden="true"
          >
            <path d="M12 3v12" />
            <path d="M6 11l6 6 6-6" />
            <path d="M4 21h16" />
          </svg>
          Descargar Launcher
        </a>
        <p class="meta">Windows · .exe</p>
      </section>
    </div>

    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      // Reveal-on-scroll.
      const revealables = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduceMotion) {
        revealables.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );
        revealables.forEach((el) => observer.observe(el));
      }

      // Pointer tilt + glare on the screenshot (fine pointers only).
      const shot = document.getElementById("shot");
      const glare = shot?.querySelector<HTMLElement>(".shot-glare");
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)")
        .matches;

      if (shot && glare && finePointer && !reduceMotion) {
        shot.addEventListener("pointermove", (event) => {
          const rect = shot.getBoundingClientRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const rotateY = (px - 0.5) * 8;
          const rotateX = (0.5 - py) * 6;
          shot.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.012)`;
          glare.style.setProperty("--gx", `${px * 100}%`);
          glare.style.setProperty("--gy", `${py * 100}%`);
        });

        shot.addEventListener("pointerleave", () => {
          shot.style.transform = "";
        });
      }
    </script>
  </body>
</html>
