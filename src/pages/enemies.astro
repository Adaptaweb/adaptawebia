---
import { getLauncherRelease } from "../lib/launcher-release";

// Hidden landing page — not linked from anywhere in the site navigation.
// Single purpose: download the Enemies: Protocolo Cero launcher.

// The button points at our own redirect, which resolves the current build
// from the release manifest; this read is only for the version label.
const DOWNLOAD_URL = "/enemies/download";
const release = await getLauncherRelease();

// Keep the page out of search engines.
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enemies: Protocolo Cero — Launcher</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#0B0F0A" />
    <link rel="icon" href="/enemies/icon.png" />
    <link rel="preload" as="image" href="/enemies/launcher.webp" />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        background-color: #0b0f0a;
      }

      body {
        font-family: "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
        color: #e8f3e2;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      ::selection {
        background-color: #7ac943;
        color: #0b0f0a;
      }

      /* ---------- fixed background ---------- */

      .bg-video {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        filter: saturate(1.05) contrast(1.05) brightness(0.5);
      }

      .bg-overlay {
        position: fixed;
        inset: 0;
        z-index: 1;
        background:
          radial-gradient(
            circle at 50% 30%,
            rgba(122, 201, 67, 0.14),
            transparent 55%
          ),
          linear-gradient(
            to bottom,
            rgba(11, 15, 10, 0.84) 0%,
            rgba(11, 15, 10, 0.66) 35%,
            rgba(11, 15, 10, 0.94) 100%
          );
      }

      /* Subtle scanline texture for the post-apocalyptic feel. */
      .bg-scanlines {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        opacity: 0.25;
        background-image: repeating-linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.35) 0px,
          rgba(0, 0, 0, 0.35) 1px,
          transparent 1px,
          transparent 3px
        );
      }

      .page {
        position: relative;
        z-index: 3;
      }

      /* ---------- single-screen layout ---------- */

      .page {
        position: relative;
        z-index: 3;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        padding: 1.75rem 1.25rem 2rem;
        text-align: center;
      }

      .eyebrow {
        margin: 0;
        font-size: 0.72rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #7ac943;
        animation: fade-up 0.8s ease-out both;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.6rem, 4.5vw, 2.4rem);
        font-weight: 800;
        letter-spacing: 0.02em;
        animation: fade-up 0.8s ease-out 0.08s both;
      }

      .tagline {
        margin: 0;
        max-width: 54ch;
        font-size: clamp(0.92rem, 2.2vw, 1.05rem);
        line-height: 1.6;
        color: #b6c9ad;
        animation: fade-up 0.8s ease-out 0.16s both;
      }

      /* ---------- download button ---------- */

      .download {
        --glow: rgba(122, 201, 67, 0.45);
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        margin-top: 0.35rem;
        padding: 1.1rem 2.5rem;
        border: 2px solid #7ac943;
        border-radius: 10px;
        background: linear-gradient(180deg, #7ac943 0%, #4e8f28 100%);
        color: #08120a;
        font-size: clamp(1.05rem, 2.6vw, 1.3rem);
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        overflow: hidden;
        box-shadow:
          0 0 26px var(--glow),
          0 10px 30px rgba(0, 0, 0, 0.55),
          inset 0 1px 0 rgba(255, 255, 255, 0.35);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          filter 0.18s ease;
        animation:
          fade-up 0.8s ease-out 0.56s both,
          pulse-glow 3s ease-in-out 1.6s infinite;
      }

      /* Light sweep across the button. */
      .download::after {
        content: "";
        position: absolute;
        top: 0;
        left: -60%;
        width: 45%;
        height: 100%;
        background: linear-gradient(
          100deg,
          transparent,
          rgba(255, 255, 255, 0.55),
          transparent
        );
        transform: skewX(-20deg);
        animation: sweep 4.5s ease-in-out 2.2s infinite;
        pointer-events: none;
      }

      .download:hover,
      .download:focus-visible {
        transform: translateY(-3px);
        filter: brightness(1.08);
        box-shadow:
          0 0 44px var(--glow),
          0 16px 40px rgba(0, 0, 0, 0.6),
          inset 0 1px 0 rgba(255, 255, 255, 0.45);
      }

      .download:focus-visible {
        outline: 3px solid #e8f3e2;
        outline-offset: 4px;
      }

      .download:active {
        transform: translateY(0);
      }

      .download svg {
        flex: none;
        animation: bob 2.4s ease-in-out infinite;
      }

      .meta {
        margin: 0;
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #7f9276;
        animation: fade-up 0.8s ease-out 0.64s both;
      }

      /* ---------- screenshot ---------- */


      .shot-frame {
        position: relative;
        width: min(820px, 92vw, calc((100svh - 385px) * 1.62));
        min-width: 260px;
        margin: 0.15rem 0 0.25rem;
        border-radius: 12px;
        padding: 6px;
        background: linear-gradient(
          160deg,
          rgba(122, 201, 67, 0.35),
          rgba(122, 201, 67, 0.05) 45%,
          rgba(255, 69, 0, 0.22)
        );
        box-shadow:
          0 30px 80px rgba(0, 0, 0, 0.7),
          0 0 70px rgba(122, 201, 67, 0.1);
        perspective: 1200px;
        transform-style: preserve-3d;
        will-change: transform;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        animation: fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.24s backwards;
      }

      .shot-frame img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
      }

      /* Glare that follows the pointer across the screenshot. */
      .shot-glare {
        position: absolute;
        inset: 6px;
        border-radius: 8px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
        background: radial-gradient(
          circle at var(--gx, 50%) var(--gy, 50%),
          rgba(255, 255, 255, 0.16),
          transparent 45%
        );
      }

      .shot-frame:hover .shot-glare {
        opacity: 1;
      }

      .features {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem 0.75rem;
      }

      .features li {
        padding: 0.45rem 0.95rem;
        border: 1px solid rgba(122, 201, 67, 0.25);
        border-radius: 999px;
        background: rgba(11, 15, 10, 0.55);
        font-size: 0.8rem;
        color: #b6c9ad;
        animation: fade-up 0.7s ease-out both;
      }

      .features li:nth-child(1) {
        animation-delay: 0.32s;
      }
      .features li:nth-child(2) {
        animation-delay: 0.38s;
      }
      .features li:nth-child(3) {
        animation-delay: 0.44s;
      }
      .features li:nth-child(4) {
        animation-delay: 0.5s;
      }

      /* ---------- keyframes ---------- */

      @keyframes fade-up {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes pulse-glow {
        0%,
        100% {
          box-shadow:
            0 0 26px var(--glow),
            0 10px 30px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 255, 255, 0.35);
        }
        50% {
          box-shadow:
            0 0 46px var(--glow),
            0 10px 30px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 255, 255, 0.35);
        }
      }

      @keyframes sweep {
        0%,
        55% {
          left: -60%;
        }
        85%,
        100% {
          left: 130%;
        }
      }

      @keyframes bob {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(3px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .eyebrow,
        h1,
        .tagline,
        .shot-frame,
        .features li,
        .download,
        .download::after,
        .download svg,
        .meta {
          animation: none;
        }
        .download,
        .shot-frame {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <video
      class="bg-video"
      src="/enemies/intro.mp4"
      poster="/enemies/logo.jpeg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"></video>
    <div class="bg-overlay" aria-hidden="true"></div>
    <div class="bg-scanlines" aria-hidden="true"></div>

    <main class="page">
      <p class="eyebrow">Enemies · Protocolo Cero</p>
      <h1>Un solo botón: JUGAR</h1>
      <p class="tagline">
        Instala Java, Forge, los mods del servidor, el tema visual y los
        shaders. Inicias sesión y entras directo a la partida.
      </p>

      <div class="shot-frame" id="shot">
        <img
          src="/enemies/launcher.webp"
          alt="Ventana del launcher de EnemiesLand: estado del servidor, cuenta de Microsoft conectada, instalación completa de Java, Forge, mods, tema visual y shaders, y el botón JUGAR"
          width="1620"
          height="1000"
          fetchpriority="high"
          decoding="async"
        />
        <span class="shot-glare" aria-hidden="true"></span>
      </div>

      <ul class="features">
        <li>Instala Java automáticamente</li>
        <li>Forge 1.20.1</li>
        <li>Mods y shaders</li>
        <li>Login con Microsoft</li>
      </ul>

      <a class="download" href={DOWNLOAD_URL} download>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="square"
          stroke-linejoin="miter"
          aria-hidden="true"
        >
          <path d="M12 3v12" />
          <path d="M6 11l6 6 6-6" />
          <path d="M4 21h16" />
        </svg>
        Descargar Launcher
      </a>

      <p class="meta">
        {release.version && <>v{release.version} · </>}Windows · .exe
      </p>
    </main>

    <script>
      const shot = document.getElementById("shot");
      const glare = shot?.querySelector<HTMLElement>(".shot-glare");
      const finePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)"
      ).matches;
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (shot && glare && finePointer && !reduceMotion) {
        shot.addEventListener("pointermove", (event) => {
          const rect = shot.getBoundingClientRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const rotateY = (px - 0.5) * 8;
          const rotateX = (0.5 - py) * 6;
          shot.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.012)`;
          glare.style.setProperty("--gx", `${px * 100}%`);
          glare.style.setProperty("--gy", `${py * 100}%`);
        });

        shot.addEventListener("pointerleave", () => {
          shot.style.transform = "";
        });
      }
    </script>
  </body>
</html>
