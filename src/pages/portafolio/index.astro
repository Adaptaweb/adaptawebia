---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/landing/Nav.astro";
import Footer from "@/components/landing/Footer.astro";
import Onda from "@/components/portafolio/Onda.astro";
import { proyectos, portada, dominio, tieneFicha } from "@/lib/proyectos";
import "@/styles/landing.css";
import "@/styles/portafolio.css";
---

<BaseLayout
  title="Portafolio — AdaptaWeb"
  description="Nueve sistemas en producción: control de acceso, gestión de gastos, kanban visual, apps móviles offline y automatización en casa. Con qué se construyó cada uno y por qué."
>
  <div class="aw-landing" style="width: 100%; overflow-x: clip; background: #07080A">
    <Nav />

    <main class="pf">
      <header class="pf-head">
        <p class="pf-eyebrow">Portafolio</p>
        <h1>Sistemas que ya están corriendo.</h1>
        <p class="pf-sub">
          No son maquetas ni plantillas adaptadas. Cada uno resuelve un problema
          concreto de alguien, con su base de datos, su API y sus apps. Entra a
          cualquiera para ver cómo está hecho por dentro.
        </p>
      </header>

      <ul class="pf-grid">
        {
          proyectos.map((p) => {
            const c = portada(p);
            return (
              <li class="pf-card">
                <a href={`/portafolio/${p.slug}`}>
                  {c && (
                    <span class:list={["pf-shot", `pf-shot-${c.device === "phone" ? "phone" : "win"}`]}>
                      {/* La misma captura, ampliada y desenfocada, pinta el fondo. */}
                      <img class="pf-blur" src={c.img} alt="" aria-hidden="true" loading="lazy" decoding="async" />

                      {c.device === "phone" ? (
                        <span class="pf-phone">
                          <img src={c.img} alt="" loading="lazy" decoding="async" />
                          {c.video && (
                            <video
                              class="pf-hover"
                              src={c.video}
                              data-base={c.base}
                              data-phase="claro"
                              data-clips={c.clips ? JSON.stringify(c.clips) : undefined}
                              muted
                              loop={!c.clips}
                              playsinline
                              preload="none"
                              aria-hidden="true"
                            />
                          )}
                        </span>
                      ) : (
                        <span class="pf-win">
                          <span class="pf-bar" aria-hidden="true">
                            <i style="background: #FF5F57" />
                            <i style="background: #FEBC2E" />
                            <i style="background: #28C840" />
                            <span>{dominio(p)}</span>
                          </span>
                          <span class="pf-screen">
                            <img src={c.img} alt="" loading="lazy" decoding="async" />
                            {c.video && (
                              <video
                                class="pf-hover"
                                src={c.video}
                                data-base={c.base}
                                data-phase="claro"
                                data-clips={c.clips ? JSON.stringify(c.clips) : undefined}
                                muted
                                loop={!c.clips}
                                playsinline
                                preload="none"
                                aria-hidden="true"
                              />
                            )}
                          </span>
                        </span>
                      )}
                    </span>
                  )}

                  <span class="pf-body">
                    <span class="pf-type">{p.type}</span>
                    <span class="pf-name" style={`view-transition-name: caso-${p.slug}`}>
                      {p.shortName ?? p.name}
                    </span>
                    <span class="pf-desc">{p.description}</span>
                    <span class="pf-keys">
                      {p.keywords.slice(0, 4).map((k) => (
                        <span class="pf-key">{k}</span>
                      ))}
                    </span>
                    <span class="pf-go">
                      {tieneFicha(p) ? "Ver el caso completo" : "Ver el proyecto"}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <aside class="pf-cta">
        <h2>¿Tienes un proceso que todavía vive en planillas?</h2>
        <p>Cuéntanos qué se hace a mano y te decimos qué se puede resolver, con alcance y plazo por escrito.</p>
        <a class="btn" href="/#cotizar">Cotizar proyecto</a>
      </aside>
    </main>

    <Onda de="#07080A" a="#060708" alt filete />

    <Footer />
  </div>
</BaseLayout>

<script>
  import { changeClip, loadClip, type Phase } from "@/lib/demo-tema";

  // La tarjeta con demo la reproduce solo mientras el cursor está encima; el
  // resto se queda en su captura. Con varios clips, al terminar uno empieza
  // el siguiente y después del último vuelve al primero.
  for (const card of document.querySelectorAll<HTMLElement>(".pf-card")) {
    const video = card.querySelector<HTMLVideoElement>(".pf-hover");
    if (!video) continue;
    const clips: string[] = JSON.parse(video.dataset.clips ?? "[]");
    const fase = () => (video.dataset.phase as Phase | undefined) ?? "claro";

    video.addEventListener("playing", () => video.classList.add("viendo"));
    video.addEventListener("ended", () => {
      if (clips.length < 2) return;
      const siguiente = clips[(clips.indexOf(video.dataset.base!) + 1) % clips.length];
      changeClip(video, siguiente, fase());
    });

    const partir = () => video.play().catch(() => {});
    const parar = () => {
      video.pause();
      video.classList.remove("viendo");
      // Vuelve al primer clip para que la captura de abajo vuelva a calzar.
      if (clips.length > 1 && video.dataset.base !== clips[0]) loadClip(video, clips[0], fase());
      else video.currentTime = 0;
    };

    card.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && partir());
    card.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && parar());
  }
</script>

<script>
  import { initLanding } from "@/scripts/landing.js";
  initLanding();
</script>
