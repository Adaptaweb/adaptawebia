---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/landing/Nav.astro";
import Footer from "@/components/landing/Footer.astro";
import Demos from "@/components/portafolio/Demos.astro";
import Escenario from "@/components/portafolio/Escenario.astro";
import Reproductor from "@/components/portafolio/Reproductor.astro";
import Onda from "@/components/portafolio/Onda.astro";
import { proyectos, fecha, partirHighlights, type Proyecto } from "@/lib/proyectos";
import "@/styles/landing.css";
import "@/styles/portafolio.css";

// Prerenderizadas para que entren al sitemap y para que la transición entre
// páginas tenga su regla leída antes del primer pintado.
export const prerender = true;

export const getStaticPaths = (() =>
  proyectos.map((proyecto, i) => ({
    params: { slug: proyecto.slug },
    props: { proyecto, siguiente: proyectos[(i + 1) % proyectos.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  proyecto: Proyecto;
  siguiente: Proyecto;
}

const { proyecto: p, siguiente } = Astro.props;
const { frases, fichas } = partirHighlights(p.highlights);

// Todas las pantallas en un solo reproductor: en una columna que se queda
// quieta no caben tres marcos, y el formato lo pone cada clip.
const medios = p.media ?? [];
const hayClips = medios.some((m) => m.src);
const fondo = medios.find((m) => m.src)?.src;

const columnas = p.architecture
  ? [
      { titulo: "Clientes", nodos: p.architecture.clients },
      { titulo: "Servicios", nodos: p.architecture.services },
      { titulo: "Datos", nodos: p.architecture.data },
    ]
  : [];

const CABECERA = "#1F1F1F";
const CUERPO = "#0E1110";
const CIERRE = "#07080A";
const PIE = "#060708";
---

<BaseLayout title={`${p.shortName ?? p.name} — AdaptaWeb`} description={p.description}>
  <div class="aw-landing" style="width: 100%; overflow-x: clip; background: #07080A">
    <Nav />

    <main>
      <!-- ============ CABECERA ============ -->
      <section class="cs-sec" style={`background: ${CABECERA}`}>
        <div class="cs">
          <a class="cs-volver" href="/portafolio">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg>
            Portafolio
          </a>

          <header>
            <p class="cs-meta">
              <span>{p.type}</span>
              <span>{p.entity}</span>
              <span>{fecha(p.startDate, p.endDate)}</span>
            </p>
            <h1>{p.name}</h1>
            <p class="cs-desc">{p.summary ?? p.description}</p>

            <ul class="cs-keys">{p.keywords.map((k) => <li>{k}</li>)}</ul>

            {
              p.url && (
                <a
                  class="cs-live"
                  href={p.url}
                  target={p.url.startsWith("http") ? "_blank" : undefined}
                  rel={p.url.startsWith("http") ? "noopener noreferrer" : undefined}
                >
                  {p.urlLabel ?? "Verlo en vivo"}
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                </a>
              )
            }
          </header>
        </div>
      </section>

      <Onda de={CABECERA} a={CUERPO} />

      <!-- ============ CUERPO EN DOS COLUMNAS ============ -->
      <!-- La demo se queda quieta a la derecha y la información pasa por
           delante. En pantallas angostas se apila, y la demo va primero. -->
      <section class="cs-sec" style={`background: ${CUERPO}`}>
        <div class="cs cs-dos">
          {
            medios.length > 0 && (
              <aside class="cs-escena">
                <Demos selector={hayClips}>
                  <Escenario backdrop={fondo}>
                    <Reproductor clips={medios} app={p.shortName ?? p.name} />
                  </Escenario>
                </Demos>
              </aside>
            )
          }

          <div class="cs-info">
            {
              (frases.length > 0 || fichas.length > 0) && (
                <div class="cs-bloque">
                  <h2 class="cs-label">Lo que resuelve</h2>
                  {frases.length > 0 && <ul class="cs-lista">{frases.map((h) => <li>{h}</li>)}</ul>}
                  {fichas.length > 0 && (
                    <ul class="cs-detalles">
                      {fichas.map((d) => (
                        <li>
                          <h3>{d.title}</h3>
                          <p>{d.body}</p>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              )
            }

            {
              p.uxDetails && (
                <div class="cs-bloque">
                  <h2 class="cs-label">Detalles de experiencia</h2>
                  <ul class="cs-detalles">
                    {p.uxDetails.map((d) => (
                      <li>
                        <h3>{d.title}</h3>
                        <p>{d.body}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              p.problem && (
                <div class="cs-bloque">
                  <h2 class="cs-label">El problema</h2>
                  <p class="cs-parrafo">{p.problem}</p>
                </div>
              )
            }

            {
              p.context && (
                <div class="cs-bloque">
                  <h2 class="cs-label">Contexto</h2>
                  <ul class="cs-lista">{p.context.map((c) => <li>{c}</li>)}</ul>
                </div>
              )
            }

            {
              columnas.length > 0 && (
                <div class="cs-bloque">
                  <h2 class="cs-label">Arquitectura</h2>
                  <div class="cs-arq">
                    {columnas.map((col) => (
                      <div class="cs-col">
                        <h3>{col.titulo}</h3>
                        <ul>
                          {col.nodos.map((n) => (
                            <li class:list={["cs-nodo", n.primary && "clave"]}>
                              <b>{n.name}</b>
                              <span>{n.detail}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }

            {
              p.decisions && (
                <div class="cs-bloque">
                  <h2 class="cs-label">Decisiones</h2>
                  <ul class="cs-detalles">
                    {p.decisions.map((d) => (
                      <li>
                        <h3>{d.title}</h3>
                        <p>{d.body}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              p.results && (
                <div class="cs-bloque">
                  <h2 class="cs-label">Resultado</h2>
                  <ul class="cs-lista">{p.results.map((r) => <li>{r}</li>)}</ul>
                </div>
              )
            }
          </div>
        </div>
      </section>

      <Onda de={CUERPO} a={CIERRE} alt />

      <!-- ============ SIGUIENTE ============ -->
      <section class="cs-sec" style={`background: ${CIERRE}`}>
        <div class="cs">
          <nav class="cs-sig" aria-label="Siguiente proyecto">
            <p>Siguiente</p>
            <a href={`/portafolio/${siguiente.slug}`}>
              {siguiente.shortName ?? siguiente.name}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          </nav>
        </div>
      </section>
    </main>

    <Onda de={CIERRE} a={PIE} alt filete />

    <Footer />
  </div>
</BaseLayout>

<script>
  import { initLanding } from "@/scripts/landing.js";
  initLanding();
</script>
