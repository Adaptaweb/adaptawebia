---
import { RPG_LAUNCHER, getLauncherRelease } from "../lib/launcher-release";

// Hidden landing page — not linked from anywhere in the site navigation.
// Single purpose: download the KEO RPG launcher.

// The button points at our own redirect, which resolves the current build
// from the release manifest; this read is only for the version label.
const DOWNLOAD_URL = "/rpg/download";
const release = await getLauncherRelease(RPG_LAUNCHER);

// Keep the page out of search engines.
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KEO RPG — Launcher</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#0B0810" />
    <link rel="icon" href="/rpg/icon.png" />
    <link rel="preload" as="image" href="/rpg/launcher.webp" />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        background-color: #0b0810;
      }

      body {
        font-family: "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
        color: #ece3f5;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      ::selection {
        background-color: #d9a93f;
        color: #1a1027;
      }

      /* ---------- fixed background ---------- */

      .bg-glow {
        position: fixed;
        inset: 0;
        z-index: 0;
        background:
          radial-gradient(
            80% 60% at 50% 12%,
            rgba(142, 98, 201, 0.35),
            transparent 60%
          ),
          radial-gradient(
            70% 50% at 50% 100%,
            rgba(217, 169, 63, 0.12),
            transparent 65%
          ),
          linear-gradient(180deg, #2a1a44 0%, #170f24 45%, #0b0810 100%);
      }

      /* Subtle scanline texture, same treatment as the launcher's veil. */
      .bg-scanlines {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        opacity: 0.22;
        background-image: repeating-linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.35) 0px,
          rgba(0, 0, 0, 0.35) 1px,
          transparent 1px,
          transparent 3px
        );
      }

      /* ---------- server status pill ---------- */

      .server-status {
        position: fixed;
        top: 1.1rem;
        right: 1.1rem;
        z-index: 4;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 1rem;
        border: 1px solid rgba(217, 169, 63, 0.3);
        border-radius: 999px;
        background: rgba(11, 8, 16, 0.72);
        backdrop-filter: blur(6px);
        font-size: 0.82rem;
        color: #e4d6ef;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        animation: fade-up 0.6s ease-out both;
      }

      .server-status[hidden] {
        display: none;
      }

      .server-dot {
        width: 8px;
        height: 8px;
        flex: none;
        border-radius: 50%;
        background: #8ec63f;
        box-shadow: 0 0 0 0 rgba(142, 198, 63, 0.55);
        animation: ping 2.4s ease-out infinite;
      }

      .server-status.offline {
        border-color: rgba(255, 90, 60, 0.3);
        color: #d9b4ab;
      }

      .server-status.offline .server-dot {
        background: #ff5a3c;
        animation: none;
      }

      @media (max-width: 560px) {
        .server-status {
          top: 0.5rem;
          right: 50%;
          transform: translateX(50%);
          font-size: 0.76rem;
        }

        /* Centred at the top, so the content has to start below it. The
           screenshot gives back the height that clearance costs. */
        .page {
          padding-top: 3.9rem;
        }

        .shot-frame {
          width: min(820px, 86vw, calc((100svh - 415px) * 1.54));
        }
      }

      /* ---------- single-screen layout ---------- */

      .page {
        position: relative;
        z-index: 3;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        padding: 1.75rem 1.25rem 2rem;
        text-align: center;
      }

      .eyebrow {
        margin: 0;
        font-size: 0.72rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #f3d58a;
        animation: fade-up 0.8s ease-out both;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.6rem, 4.5vw, 2.4rem);
        font-weight: 800;
        letter-spacing: 0.02em;
        animation: fade-up 0.8s ease-out 0.08s both;
      }

      .tagline {
        margin: 0;
        max-width: 54ch;
        font-size: clamp(0.92rem, 2.2vw, 1.05rem);
        line-height: 1.6;
        color: #bdaecd;
        animation: fade-up 0.8s ease-out 0.16s both;
      }

      /* ---------- download button ---------- */

      .download {
        --glow: rgba(217, 169, 63, 0.4);
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        margin-top: 0.35rem;
        padding: 1.1rem 2.5rem;
        border: 2px solid #f3d58a;
        border-radius: 10px;
        background: linear-gradient(180deg, #f3d58a 0%, #c9992c 100%);
        color: #241605;
        font-size: clamp(1.05rem, 2.6vw, 1.3rem);
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        overflow: hidden;
        box-shadow:
          0 0 26px var(--glow),
          0 10px 30px rgba(0, 0, 0, 0.55),
          inset 0 1px 0 rgba(255, 255, 255, 0.45);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          filter 0.18s ease;
        animation:
          fade-up 0.8s ease-out 0.56s both,
          pulse-glow 3s ease-in-out 1.6s infinite;
      }

      /* Light sweep across the button. */
      .download::after {
        content: "";
        position: absolute;
        top: 0;
        left: -60%;
        width: 45%;
        height: 100%;
        background: linear-gradient(
          100deg,
          transparent,
          rgba(255, 255, 255, 0.55),
          transparent
        );
        transform: skewX(-20deg);
        animation: sweep 4.5s ease-in-out 2.2s infinite;
        pointer-events: none;
      }

      .download:hover,
      .download:focus-visible {
        transform: translateY(-3px);
        filter: brightness(1.08);
        box-shadow:
          0 0 44px var(--glow),
          0 16px 40px rgba(0, 0, 0, 0.6),
          inset 0 1px 0 rgba(255, 255, 255, 0.55);
      }

      .download:focus-visible {
        outline: 3px solid #ece3f5;
        outline-offset: 4px;
      }

      .download:active {
        transform: translateY(0);
      }

      .download svg {
        flex: none;
        animation: bob 2.4s ease-in-out infinite;
      }

      .meta {
        margin: 0;
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #8e7ba3;
        animation: fade-up 0.8s ease-out 0.64s both;
      }

      /* ---------- screenshot ---------- */

      .shot-frame {
        position: relative;
        width: min(820px, 92vw, calc((100svh - 415px) * 1.54));
        min-width: 260px;
        margin: 0.15rem 0 0.25rem;
        border-radius: 12px;
        padding: 6px;
        background: linear-gradient(
          160deg,
          rgba(243, 213, 138, 0.35),
          rgba(142, 98, 201, 0.18) 45%,
          rgba(107, 63, 160, 0.3)
        );
        box-shadow:
          0 30px 80px rgba(0, 0, 0, 0.7),
          0 0 70px rgba(107, 63, 160, 0.18);
        perspective: 1200px;
        transform-style: preserve-3d;
        will-change: transform;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        animation: fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.24s backwards;
      }

      .shot-frame img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
      }

      /* Glare that follows the pointer across the screenshot. */
      .shot-glare {
        position: absolute;
        inset: 6px;
        border-radius: 8px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
        background: radial-gradient(
          circle at var(--gx, 50%) var(--gy, 50%),
          rgba(255, 255, 255, 0.16),
          transparent 45%
        );
      }

      .shot-frame:hover .shot-glare {
        opacity: 1;
      }

      /* ---------- feature chips ---------- */

      .features {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem 0.75rem;
      }

      .features li {
        padding: 0.45rem 0.95rem;
        border: 1px solid rgba(142, 98, 201, 0.35);
        border-radius: 999px;
        background: rgba(11, 8, 16, 0.55);
        font-size: 0.8rem;
        color: #bdaecd;
        animation: fade-up 0.7s ease-out both;
      }

      .features li:nth-child(1) {
        animation-delay: 0.32s;
      }
      .features li:nth-child(2) {
        animation-delay: 0.38s;
      }
      .features li:nth-child(3) {
        animation-delay: 0.44s;
      }
      .features li:nth-child(4) {
        animation-delay: 0.5s;
      }

      /* ---------- keyframes ---------- */

      @keyframes fade-up {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes pulse-glow {
        0%,
        100% {
          box-shadow:
            0 0 26px var(--glow),
            0 10px 30px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 255, 255, 0.45);
        }
        50% {
          box-shadow:
            0 0 46px var(--glow),
            0 10px 30px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 255, 255, 0.45);
        }
      }

      @keyframes sweep {
        0%,
        55% {
          left: -60%;
        }
        85%,
        100% {
          left: 130%;
        }
      }

      @keyframes ping {
        0% {
          box-shadow: 0 0 0 0 rgba(142, 198, 63, 0.55);
        }
        70%,
        100% {
          box-shadow: 0 0 0 7px rgba(142, 198, 63, 0);
        }
      }

      @keyframes bob {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(3px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .server-status,
        .server-dot,
        .eyebrow,
        h1,
        .tagline,
        .shot-frame,
        .features li,
        .download,
        .download::after,
        .download svg,
        .meta {
          animation: none;
        }
        .download,
        .shot-frame {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>
    <div class="bg-scanlines" aria-hidden="true"></div>

    <div class="server-status" id="server-status" hidden>
      <span class="server-dot" aria-hidden="true"></span>
      <span id="server-status-text"></span>
    </div>

    <main class="page">
      <p class="eyebrow">KEO RPG · Optimized</p>
      <h1>Un solo botón: JUGAR</h1>
      <p class="tagline">
        Más de 200 mods en español: clases RPG, magia y 37 jefes. El launcher
        instala Java, NeoForge y el modpack completo, y te conecta directo al
        servidor.
      </p>

      <div class="shot-frame" id="shot">
        <img
          src="/rpg/launcher.webp"
          alt="Ventana del launcher de KEO RPG: estado del servidor, cuenta de Microsoft conectada, instalación completa de Java, NeoForge, mods, tema visual y shaders, y el botón JUGAR"
          width="1620"
          height="1049"
          fetchpriority="high"
          decoding="async"
        />
        <span class="shot-glare" aria-hidden="true"></span>
      </div>

      <ul class="features">
        <li>Instala Java automáticamente</li>
        <li>NeoForge 1.21.1</li>
        <li>+200 mods en español</li>
        <li>Login con Microsoft</li>
      </ul>

      <a class="download" href={DOWNLOAD_URL} download>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="square"
          stroke-linejoin="miter"
          aria-hidden="true"
        >
          <path d="M12 3v12" />
          <path d="M6 11l6 6 6-6" />
          <path d="M4 21h16" />
        </svg>
        Descargar Launcher
      </a>

      <p class="meta">
        {release.version && <>v{release.version} · </>}Windows · .exe
      </p>
    </main>

    <script>
      // Live server status, fetched after load so the page never waits on it.
      const statusPill = document.getElementById("server-status");
      const statusText = document.getElementById("server-status-text");

      async function refreshServerStatus() {
        if (!statusPill || !statusText) return;
        try {
          const response = await fetch("/rpg/status.json", {
            signal: AbortSignal.timeout(6000),
          });
          if (!response.ok) throw new Error(String(response.status));

          const data = await response.json();
          statusPill.classList.toggle("offline", !data.online);
          statusText.textContent = data.online
            ? `Online · ${data.players}/${data.max} conectados`
            : "Servidor fuera de línea";
          statusPill.hidden = false;
        } catch {
          // Leave the pill hidden rather than showing a status we don't have.
          statusPill.hidden = true;
        }
      }

      refreshServerStatus();
      setInterval(refreshServerStatus, 60000);

      // Pointer tilt + glare on the screenshot (fine pointers only).
      const shot = document.getElementById("shot");
      const glare = shot?.querySelector<HTMLElement>(".shot-glare");
      const finePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)"
      ).matches;
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (shot && glare && finePointer && !reduceMotion) {
        shot.addEventListener("pointermove", (event) => {
          const rect = shot.getBoundingClientRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const rotateY = (px - 0.5) * 8;
          const rotateX = (0.5 - py) * 6;
          shot.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.012)`;
          glare.style.setProperty("--gx", `${px * 100}%`);
          glare.style.setProperty("--gy", `${py * 100}%`);
        });

        shot.addEventListener("pointerleave", () => {
          shot.style.transform = "";
        });
      }
    </script>
  </body>
</html>
