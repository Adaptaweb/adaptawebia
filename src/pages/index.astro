---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import ThreeBackground from "../components/ThreeBackground.astro";
import Hero from "../components/Hero.astro";
import Servicios from "../components/Servicios.astro";
import SkillsSection from "../components/SkillsSection.astro";
import ProyectosWrapper from "../components/ProyectosWrapper.astro";
import ContactGlobeWrapper from "../components/ContactGlobeWrapper.astro";
import FooterWrapper from "../components/FooterWrapper.astro";
import { SeparatorPro } from "../components/ui/seperatorpro";
---

<BaseLayout
  title="AdaptaWeb — Desarrollo Inteligente con IA"
  description="Creamos aplicaciones móviles y plataformas web que, gracias a la IA, se adaptan en tiempo real al comportamiento de los usuarios."
>
  <ThreeBackground />
  <Navigation />
  <main class="relative z-10">
    <Hero />
    <SeparatorPro variant="default" client:load />
    <Servicios />
    <SeparatorPro variant="default" client:load />
    <ProyectosWrapper />
    <SeparatorPro variant="default" client:load />
    <SkillsSection />
    <SeparatorPro variant="default" client:load />
    <ContactGlobeWrapper />
  </main>
  <FooterWrapper />
</BaseLayout>

<script>
import { initHeroReveal, initScrollReveal } from "../scripts/scroll-reveal";

document.addEventListener("DOMContentLoaded", () => {
  initHeroReveal();
  initScrollReveal();
});
</script>
