---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import ThreeBackground from "../components/ThreeBackground.astro";
import HeroSection from "../components/HeroSection";
import Servicios from "../components/Servicios.astro";
import AplicacionesSection from "../components/AplicacionesSection";
import SkillsSection from "../components/SkillsSection.astro";
import ContactSection from "../components/ContactSection";
import FooterWrapper from "../components/FooterWrapper.astro";
import SectionDivider from "../components/SectionDivider.astro";
---

<BaseLayout
  title="AdaptaWeb — Desarrollo Inteligente con IA"
  description="Creamos aplicaciones móviles y plataformas web que, gracias a la IA, se adaptan en tiempo real al comportamiento de los usuarios."
>
  <ThreeBackground />
  <Navigation />
  <main class="relative z-10 overflow-x-clip">
    <HeroSection client:load />
    <SectionDivider />
    <Servicios />
    <SectionDivider />
    <AplicacionesSection client:visible />
    <SectionDivider />
    <SkillsSection />
    <SectionDivider />
    <ContactSection client:load />
  </main>
  <FooterWrapper />
</BaseLayout>

<script>
import { initParallax, initScrollReveal } from "../scripts/scroll-reveal";

document.addEventListener("DOMContentLoaded", () => {
  initScrollReveal();
  initParallax();
});
</script>
