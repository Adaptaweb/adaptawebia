---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/landing/Nav.astro";
import Hero from "../components/landing/Hero.astro";
import Servicios from "../components/landing/Servicios.astro";
import Trabajo from "../components/landing/Trabajo.astro";
import Proceso from "../components/landing/Proceso.astro";
import Comparativa from "../components/landing/Comparativa.astro";
import Cotizar from "../components/landing/Cotizar.astro";
import Faq from "../components/landing/Faq.astro";
import Contacto from "../components/landing/Contacto.astro";
import Footer from "../components/landing/Footer.astro";
import "../styles/landing.css";
---

<BaseLayout
  title="AdaptaWeb — Desarrollo Inteligente con IA"
  description="Creamos aplicaciones móviles y plataformas web que, gracias a la IA, se adaptan en tiempo real al comportamiento de los usuarios."
>
  <div class="aw-landing" style="width: 100%; overflow-x: clip; background: #07080A">
    <Nav />
    <main>
      <Hero />
      <Servicios />
      <Trabajo />
      <Proceso />
      <Comparativa />
      <Cotizar />
      <Faq />
      <Contacto />
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  import { initLanding } from "../scripts/landing.js";
  initLanding();
</script>
