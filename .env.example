# Cloudflare Turnstile — protege el formulario de contacto.
# Claves de prueba (siempre aprueban): 1x00000000000000000000AA
# y 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — envia el aviso a hola@adaptaweb.cl y el acuse al visitante.
# Sin esta clave el endpoint responde bien pero no manda ningun correo.
RESEND_API_KEY=
